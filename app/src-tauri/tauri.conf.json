{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lantai",
  "identifier": "me.wohin.lantai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run bundle-cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lantai",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "copyright": "Copyright © 2026 The Lantai Authors. Licensed under MIT OR Apache-2.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/zh-Hans.lproj/InfoPlist.strings": "./macos/zh-Hans.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings",
        "MacOS/aj": "../../target/aj-bundle/aj"
      },
      "signingIdentity": "-"
    }
  }
}
