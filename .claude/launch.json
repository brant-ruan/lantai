{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "website"
      ],
      "port": 4173
    }
  ]
}
